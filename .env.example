# The public origin. NEVER a *.vercel.app URL — the preview deployment is just
# where the test build lives; nothing in shipped code may reference that host.
# Leave unset locally: the code falls back to the real domain.
NEXT_PUBLIC_SITE_URL=https://peptidescostarica.net

# Safe default for local and preview deployments. Set this to true only in the
# production environment at the same moment the real domain is cut over.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Where content images are served from.
#
# During the rebuild this points at the live WordPress site so the replica looks
# right immediately. Before launch it becomes empty (local /public files) or a
# Supabase Storage origin. Content files store paths only, so changing this
# moves every image at once — see lib/images.js.
# Assets are mirrored into public/, so production does not depend on WordPress.
NEXT_PUBLIC_IMAGE_BASE=
